# Copy to .env and replace placeholders with credentials/topic names from your Kafka provider.
# Never commit .env or paste secret values into source code.
BOOTSTRAP_SERVERS=your-kafka-bootstrap-server
KAFKA_API_KEY=replace-with-api-key
KAFKA_API_SECRET=replace-with-api-secret
ORDER_TOPIC=your-order-topic
DELIVERY_TOPIC=your-delivery-topic
PRODUCT_TOPIC=your-product-topic
RIDER_TOPIC=your-rider-topic
